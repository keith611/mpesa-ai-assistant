# ---------- App ----------
APP_NAME=M-Pesa AI Assistant
ENV=development
DEBUG=true

# ---------- Database (Supabase / Postgres) ----------
# From Supabase: Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ---------- Security ----------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Device / WhatsApp API keys ----------
# Shared secret the Android app must send in the X-Device-Api-Key header.
DEVICE_API_KEY=CHANGE_ME_DEVICE_KEY
# ---------- WhatsApp Cloud API ----------
# mode = "mock" -> no credentials needed at all, safe for local testing (default)
# mode = "live" -> requires real credentials below from the Meta App Dashboard
WHATSAPP_MODE=mock
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_WHATSAPP_TOKEN
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_APP_SECRET=

# Enables POST /api/v1/whatsapp/simulate for local testing without real WhatsApp.
# Set to false in production.
ENABLE_WHATSAPP_SIMULATOR=true

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000

# ---------- Rate limiting ----------
RATE_LIMIT_PER_MINUTE=60

# ---------- Local storage paths (relative to backend/) ----------
# Only used for CSV snapshot backups now — the actual datastore is Postgres.
DATA_DIR=data
BACKUP_DIR=backups

# ---------- Backup retention ----------
HOURLY_BACKUPS_TO_KEEP=24
DAILY_BACKUPS_TO_KEEP=30
WEEKLY_BACKUPS_TO_KEEP=12
